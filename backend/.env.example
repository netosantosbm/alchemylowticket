# Configurações de Ambiente - Plataforma LowTicket

# 1. Banco de Dados Supabase (PostgreSQL)
# Copie a connection string do Supabase (Project Settings -> Database -> Connection string -> URI)
# Formato padrão:
# DATABASE_URL=postgresql://postgres:[SUA-SENHA-SUPABASE]@db.[SEU-PROJECT-REF].supabase.co:5432/postgres
# Ou utilizando o Connection Pooler (recomendado para VPS):
# DATABASE_URL=postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA-SUPABASE]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Deixe comentado ou vazio para usar o SQLite local durante desenvolvimento:
# DATABASE_URL=

# 2. Domínio e Servidor
DOMAIN=alchemylow.shop
PORT=8000
HOST=0.0.0.0
