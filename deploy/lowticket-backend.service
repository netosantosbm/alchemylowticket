[Unit]
Description=Plataforma LowTicket FastAPI Backend Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/alchemylow/backend
EnvironmentFile=/var/www/alchemylow/backend/.env
ExecStart=/var/www/alchemylow/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
